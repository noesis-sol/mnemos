{
  "name": "mnemos-mcp",
  "version": "0.3.0",
  "description": "Read-only MCP server exposing local Chrome bookmarks as a signal of what the user values and endorses",
  "type": "module",
  "bin": {
    "mnemos-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "test": "npm run build && node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noesis-sol/mnemos.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "chrome",
    "bookmarks",
    "claude",
    "ai"
  ],
  "author": "Michail Michailidis",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
