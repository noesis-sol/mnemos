{
  "name": "mnemos-mcp",
  "version": "0.5.0",
  "description": "MCP server exposing local browser bookmarks (Chrome, Edge, Brave, Vivaldi, Opera, Chromium, Firefox, Safari) as a signal of what the user values and endorses, with local semantic search over their titles and pages",
  "type": "module",
  "bin": {
    "mnemos-mcp": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/cli.js",
    "test": "npm run build && node --test"
  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noesis-sol/mnemos.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "chrome",
    "chromium",
    "edge",
    "brave",
    "vivaldi",
    "opera",
    "firefox",
    "safari",
    "bookmarks",
    "semantic-search",
    "embeddings",
    "claude",
    "ai"
  ],
  "author": "Michail Michailidis",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.13",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "optionalDependencies": {
    "playwright-core": "^1.63.0",
    "unpdf": "^1.8.1"
  }
}
