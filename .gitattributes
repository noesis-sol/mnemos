# Check every text file out with LF, on every platform: tests compare generated
# files (src/icon.ts from scripts/build-icons.mjs, which writes LF) byte for
# byte with the committed ones, and Windows' core.autocrlf would add CRs.
* text=auto eol=lf

# Inlined into src/icon.ts byte for byte: never convert.
*.png binary

# Binary property-list fixtures (Safari bookmarks): never convert.
*.plist binary

# Tickets each add their own lines: keep both sides on a merge.
CHANGELOG.md merge=union
